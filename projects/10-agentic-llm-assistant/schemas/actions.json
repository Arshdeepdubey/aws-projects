{
  "openapi": "3.0.0",
  "info": {
    "title": "Customer operations tools",
    "version": "1.0.0",
    "description": "OpenAPI form of the action group. The CDK stack uses the inline function schema instead; keep this in sync if you switch the action group to an API schema, or if another client needs the same tools."
  },
  "paths": {
    "/orders/{orderId}": {
      "get": {
        "operationId": "get_order",
        "summary": "Look up one order by id",
        "description": "Returns status, items, total, order date and delivery date for a single order.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Order id, e.g. ORD-10428",
            "schema": { "type": "string", "pattern": "^ORD-[A-Za-z0-9]{3,12}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          }
        }
      }
    },
    "/customers/{customerId}/orders": {
      "get": {
        "operationId": "list_orders_for_customer",
        "summary": "List a customer's recent orders",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "Customer id, e.g. CUST-1042",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many to return (default 5, max 20)",
            "schema": { "type": "integer", "default": 5 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent orders, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "customerId": { "type": "string" },
                    "count": { "type": "integer" },
                    "orders": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/policies/returns/{category}": {
      "get": {
        "operationId": "get_return_policy",
        "summary": "Return window and conditions for a product category",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "description": "Product category, e.g. electronics, apparel, home, grocery",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The policy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "category": { "type": "string" },
                    "windowDays": { "type": "integer" },
                    "conditions": { "type": "string" },
                    "restockingFee": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/shipping/estimate": {
      "post": {
        "operationId": "estimate_shipping",
        "summary": "Calculate shipping cost and delivery date",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["destinationPostcode", "weightKg"],
                "properties": {
                  "destinationPostcode": { "type": "string" },
                  "weightKg": { "type": "number", "minimum": 0.1, "maximum": 50 },
                  "speed": { "type": "string", "enum": ["standard", "express", "overnight"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cost and estimated delivery",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/orders/{orderId}/returns": {
      "post": {
        "operationId": "start_return",
        "summary": "Start a return (write — confirm with the customer first)",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": { "type": "string" },
                  "idempotencyKey": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return started",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/tickets": {
      "post": {
        "operationId": "create_ticket",
        "summary": "Escalate to a human (write — confirm with the customer first)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customerId", "summary"],
                "properties": {
                  "customerId": { "type": "string" },
                  "summary": { "type": "string" },
                  "details": { "type": "string" },
                  "priority": { "type": "string", "enum": ["low", "normal", "high"] },
                  "idempotencyKey": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket created",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string" },
          "customerId": { "type": "string" },
          "status": { "type": "string" },
          "category": { "type": "string" },
          "total": { "type": "number" },
          "currency": { "type": "string" },
          "orderedAt": { "type": "string", "format": "date-time" },
          "deliveredAt": { "type": "string", "format": "date-time" },
          "estimatedDelivery": { "type": "string", "format": "date" },
          "carrier": { "type": "string" },
          "trackingNumber": { "type": "string" },
          "items": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
